{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Stardive Docs",
  "colors": {
    "primary": "#A876F9",
    "light": "#A876F9",
    "dark": "#A876F9"
  },
  "background": {
    "color": {
      "dark": "#090009"
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "development"]
          },
          {
            "group": "Essentials",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/settings",
              "essentials/navigation",
              "essentials/reusable-snippets"
            ]
          }
        ]
      },
      {
        "dropdown": "Libraries",
        "icon": "books",
        "groups": [
          {
            "group": "Rust Libraries",
            "pages": [
              "libs/rust/clap",
              "libs/rust/anyhow",
              "libs/rust/requestty",
              "libs/rust/rayon"
            ]
          },
          {
            "group": "Lua Libraries",
            "pages": [
              "libs/lua/love2d",
              "libs/lua/serpent",
              "libs/lua/argparse",
              "libs/lua/teal",
              "libs/lua/tealworks",
              "libs/lua/tealmacros"
            ]
          }
        ]
      },
      {
        "dropdown": "Projects",
        "groups": [
          {
            "group": "My Projects",
            "pages": ["projects/boss", "projects/loveui", "projects/lcs"]
          }
        ]
      },
      {
        "dropdown": "Blog",
        "groups": [
          {
            "group": "Entries",
            "pages": ["blog/first-post", "blog/second-post"]
          }
        ]
      }
    ],
    "global": {}
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Docs",
        "href": "https://mintlify.com/docs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/NQMVD"
    }
  }
}
